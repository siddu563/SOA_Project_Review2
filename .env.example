# ==============================================================================
# LEARNKNOW - Environment Configuration Template (.env)
# ==============================================================================
# Database Configuration
# Defaults to localhost:5432 with standard postgres user.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Service Discovery
# Eureka service URL used by all client microservices and API Gateway
EUREKA_URL=http://localhost:8761/eureka/

# Security & JWT Configuration
# Shared secret for signing HMAC-SHA256 tokens (minimum 256 bits / 32 characters)
JWT_SECRET=learnknow-super-secure-production-jwt-secret-key-32chars!
# Token expiration time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000
