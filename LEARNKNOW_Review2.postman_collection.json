    {
      "name": "2. Gateway Security & Validation Negative Tests",
      "item": [
        {
          "name": "2.1 Access Protected Route Without Token (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "2.2 Access With Tampered Token (Expect 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid.fake.token" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "2.3 Student Creating Course (RBAC Expect 403 Forbidden)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Course Creation Attempt\",\n  \"description\": \"Student should not be able to create courses\",\n  \"level\": \"BEGINNER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courses"]
            }
          }
        },
        {
          "name": "2.4 Call Non-Existent Gateway Route (Expect 404 Not Found)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/unknown-service-route",
              "host": ["{{baseUrl}}"],
              "path": ["api", "unknown-service-route"]
            }
          }
        }
      ]
    },
    {
